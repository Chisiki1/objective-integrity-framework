{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "status",
    "deliverables",
    "evidence_limit"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "evidence_limit": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "title": "Open Deliverable Ledger"
}
