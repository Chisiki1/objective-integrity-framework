{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://local.invalid/schemas/durable-supervisor-status-v1.json",
  "title":"Durable Supervisor status records and inputs",
  "oneOf":[
    {"$ref":"#/$defs/statusRecord"},
    {"$ref":"#/$defs/writeRequest"},
    {"$ref":"#/$defs/supervisorMessage"}
  ],
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"},
    "text":{"type":"string","minLength":1,"maxLength":4096},
    "sha":{"type":"string","pattern":"^[A-F0-9]{64}$"},
    "nullableId":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
    "nullableSha":{"oneOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},
    "utc":{"type":"string","format":"date-time"},
    "objective":{
      "type":"object","additionalProperties":false,
      "required":["objective_id","source","source_sha256","supervisor_task_id"],
      "properties":{
        "objective_id":{"$ref":"#/$defs/id"},"source":{"$ref":"#/$defs/text"},
        "source_sha256":{"$ref":"#/$defs/sha"},"supervisor_task_id":{"$ref":"#/$defs/nullableId"}
      }
    },
    "worker":{
      "type":"object","additionalProperties":false,"required":["task_id","turn_id","lease_id"],
      "properties":{"task_id":{"$ref":"#/$defs/nullableId"},"turn_id":{"$ref":"#/$defs/nullableId"},"lease_id":{"$ref":"#/$defs/nullableId"}}
    },
    "identity":{
      "type":"object","additionalProperties":false,"required":["identity_id","sha256"],
      "properties":{"identity_id":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/nullableSha"}}
    },
    "pending":{
      "type":"object","additionalProperties":false,
      "required":["state","decision_id","reason","requested_transition_id"],
      "properties":{
        "state":{"enum":["NONE","READY_FOR_SUPERVISOR","NEEDS_SUPERVISOR"]},
        "decision_id":{"$ref":"#/$defs/nullableId"},"reason":{"$ref":"#/$defs/text"},
        "requested_transition_id":{"$ref":"#/$defs/nullableId"}
      },
      "allOf":[
        {
          "if":{"properties":{"state":{"const":"NONE"}},"required":["state"]},
          "then":{"properties":{"decision_id":{"type":"null"},"requested_transition_id":{"type":"null"}}},
          "else":{"properties":{"decision_id":{"$ref":"#/$defs/id"},"requested_transition_id":{"$ref":"#/$defs/id"}}}
        }
      ]
    },
    "nextAction":{
      "type":"object","additionalProperties":false,"required":["transition_id","description","effect"],
      "properties":{
        "transition_id":{"$ref":"#/$defs/id"},"description":{"$ref":"#/$defs/text"},
        "effect":{"enum":["STATUS_ONLY","READ_ONLY","NO_EXTERNAL","MATERIAL_OR_EXTERNAL"]}
      }
    },
    "deliverable":{
      "type":"object","additionalProperties":false,"required":["deliverable_id","state","summary"],
      "properties":{"deliverable_id":{"$ref":"#/$defs/id"},"state":{"enum":["OPEN","BLOCKED","SATISFIED"]},"summary":{"$ref":"#/$defs/text"}}
    },
    "transitionGate":{
      "type":"object","additionalProperties":false,"required":["requires_supervisor_message","held_transition_id","scope"],
      "properties":{
        "requires_supervisor_message":{"type":"boolean"},"held_transition_id":{"$ref":"#/$defs/nullableId"},
        "scope":{"const":"DEPENDENT_TRANSITION_ONLY"}
      }
    },
    "messageBinding":{
      "type":"object","additionalProperties":false,
      "required":["source_thread_id","message_id","turn_id","prompt_sha256","prior_status_id","prior_status_sha256","requested_transition_id","received_at_utc"],
      "properties":{
        "source_thread_id":{"$ref":"#/$defs/id"},"message_id":{"$ref":"#/$defs/id"},"turn_id":{"$ref":"#/$defs/id"},
        "prompt_sha256":{"$ref":"#/$defs/sha"},"prior_status_id":{"$ref":"#/$defs/id"},"prior_status_sha256":{"$ref":"#/$defs/sha"},
        "requested_transition_id":{"$ref":"#/$defs/id"},"received_at_utc":{"$ref":"#/$defs/utc"}
      }
    },
    "supervisorMessage":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","source_role","source_thread_id","message_id","destination_worker_task_id","destination_turn_id","prompt","prior_status_id","prior_status_sha256","requested_transition_id","received_at_utc"],
      "properties":{
        "schema_version":{"const":"durable-supervisor-message-binding-v1"},"source_role":{"const":"SUPERVISOR"},
        "source_thread_id":{"$ref":"#/$defs/id"},"message_id":{"$ref":"#/$defs/id"},
        "destination_worker_task_id":{"$ref":"#/$defs/id"},"destination_turn_id":{"$ref":"#/$defs/id"},
        "prompt":{"type":"string","minLength":1,"maxLength":16384},"prior_status_id":{"$ref":"#/$defs/id"},
        "prior_status_sha256":{"$ref":"#/$defs/sha"},"requested_transition_id":{"$ref":"#/$defs/id"},
        "received_at_utc":{"$ref":"#/$defs/utc"}
      }
    },
    "statusRecord":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","status_id","record_sha256","sequence","previous_record_sha256","objective","worker","candidate_identity","evidence_identity","active_step","actual_evidence_delta","pending_decision","next_proposed_action","allowed_effects","prohibited_effects","open_deliverables","state","transition_gate","supervisor_message_binding","timestamp_utc","proof_ceiling"],
      "properties":{
        "schema_version":{"const":"durable-supervisor-status-v1"},"status_id":{"$ref":"#/$defs/id"},"record_sha256":{"$ref":"#/$defs/sha"},
        "sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},"previous_record_sha256":{"$ref":"#/$defs/nullableSha"},
        "objective":{"$ref":"#/$defs/objective"},"worker":{"$ref":"#/$defs/worker"},
        "candidate_identity":{"$ref":"#/$defs/identity"},"evidence_identity":{"$ref":"#/$defs/identity"},
        "active_step":{"$ref":"#/$defs/text"},"actual_evidence_delta":{"type":"array","maxItems":64,"items":{"type":"string","minLength":1,"maxLength":1024}},
        "pending_decision":{"$ref":"#/$defs/pending"},"next_proposed_action":{"$ref":"#/$defs/nextAction"},
        "allowed_effects":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},
        "prohibited_effects":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},
        "open_deliverables":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/deliverable"}},
        "state":{"enum":["CONTINUE","READY","WORK_NEEDS_ATTENTION"]},"transition_gate":{"$ref":"#/$defs/transitionGate"},
        "supervisor_message_binding":{"oneOf":[{"$ref":"#/$defs/messageBinding"},{"type":"null"}]},
        "timestamp_utc":{"$ref":"#/$defs/utc"},"proof_ceiling":{"$ref":"#/$defs/text"}
      }
    },
    "writeRequest":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","expected_previous_status_id","expected_previous_record_sha256","objective","worker","candidate_identity","evidence_identity","active_step","actual_evidence_delta","pending_decision","next_proposed_action","allowed_effects","prohibited_effects","open_deliverables","state","transition_effect","supervisor_message","proof_ceiling"],
      "properties":{
        "schema_version":{"const":"durable-supervisor-status-write-request-v1"},
        "expected_previous_status_id":{"$ref":"#/$defs/nullableId"},"expected_previous_record_sha256":{"$ref":"#/$defs/nullableSha"},
        "objective":{"$ref":"#/$defs/objective"},"worker":{"$ref":"#/$defs/worker"},
        "candidate_identity":{"$ref":"#/$defs/identity"},"evidence_identity":{"$ref":"#/$defs/identity"},
        "active_step":{"$ref":"#/$defs/text"},"actual_evidence_delta":{"type":"array","maxItems":64,"items":{"type":"string","minLength":1,"maxLength":1024}},
        "pending_decision":{"$ref":"#/$defs/pending"},"next_proposed_action":{"$ref":"#/$defs/nextAction"},
        "allowed_effects":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},
        "prohibited_effects":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},
        "open_deliverables":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/deliverable"}},
        "state":{"enum":["CONTINUE","READY","WORK_NEEDS_ATTENTION"]},
        "transition_effect":{"enum":["STATUS_ONLY","READ_ONLY_UPDATE","DEPENDENT_TRANSITION"]},
        "supervisor_message":{"oneOf":[{"$ref":"#/$defs/supervisorMessage"},{"type":"null"}]},
        "proof_ceiling":{"$ref":"#/$defs/text"}
      }
    }
  }
}
